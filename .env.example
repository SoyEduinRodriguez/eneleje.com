# eneleje.com · Variables de entorno — copiar a .env.local y EDITAR
#   cp .env.example .env.local
#   AUTH_SECRET:      openssl rand -base64 48
#   IP_HASH_PEPPER:   openssl rand -hex 32

# ── Aplicación ───────────────────────────────────────────────────────────────
PORT=3006
NEXT_PUBLIC_ROOT_DOMAIN=eneleje.com
NEXT_PUBLIC_APP_URL=https://eneleje.com

# ── PostgreSQL (rol de aplicación con RLS; lo crea el DDL completo) ──────────
DATABASE_URL=postgresql://eneleje_app:cambia_esta_clave@127.0.0.1:5432/Eneleje

# ── Seguridad de aplicación ──────────────────────────────────────────────────
AUTH_SECRET=GENERA_UN_SECRETO_LARGO
IP_HASH_PEPPER=GENERA_UN_PEPPER_LARGO
# true SOLO detrás de HTTPS (producción)
COOKIE_SECURE=false
# SOLO desarrollo: muestra el enlace de recuperación en pantalla en vez de email
DEV_RESET_LINK=false

# ── Redis (opcional en desarrollo; la app degrada a Postgres) ────────────────
# REDIS_URL=redis://127.0.0.1:6379

# ── Cloudflare Turnstile (anti-bot en registro; opcional) ────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Medios (Cloudflare R2 / S3 — fase de uploads) ────────────────────────────
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=eneleje-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_MEDIA_CDN=https://media.eneleje.com
