# =============================================================================
# eneleje.com · Variables de entorno — copiar a infra/.env y EDITAR
#   cd infra && cp env.example .env
# =============================================================================

# ── Dominio ──────────────────────────────────────────────────────────────────
# El middleware resuelve subdominios contra esta raíz.
NEXT_PUBLIC_ROOT_DOMAIN=eneleje.com
NEXT_PUBLIC_APP_URL=https://eneleje.com

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=eneleje
POSTGRES_USER=eneleje
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_SUPERUSUARIO

# Roles de aplicación (los consume db/migrations/000_roles.sh en el primer init)
ENELEJE_APP_DB_PASSWORD=CAMBIA_ESTA_CLAVE_APP
ENELEJE_MIGRATOR_DB_PASSWORD=CAMBIA_ESTA_CLAVE_MIGRATOR

# Conexión desde la app (compose la reescribe a db:5432 dentro de la red;
# úsala igual en despliegues fuera de compose apuntando al host real).
DATABASE_URL=postgres://eneleje_app:CAMBIA_ESTA_CLAVE_APP@db:5432/eneleje

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# Upstash (producción serverless): https://:<token>@<host>.upstash.io:6379

# ── Seguridad de aplicación ──────────────────────────────────────────────────
# Clave para firmar JWT de sesión (openssl rand -base64 48)
AUTH_SECRET=GENERA_UN_SECRETO_LARGO
# Pepper para hmac(ip) en business_reports.reporter_ip_hash (openssl rand -hex 32)
IP_HASH_PEPPER=GENERA_UN_PEPPER_LARGO

# Cloudflare Turnstile (anti-bot en registro y reportes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Medios (Cloudflare R2 / S3 / MinIO) ──────────────────────────────────────
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=eneleje-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dominio público del bucket (CDN): el browser solo ve URLs de aquí
NEXT_PUBLIC_MEDIA_CDN=https://media.eneleje.com

# ── Scheduler interno (job diario de analítica/mantenimiento) ────────────────
# true SOLO en una instancia de app; en Vercel usa vercel.json crons.
ENABLE_SCHEDULER=true
